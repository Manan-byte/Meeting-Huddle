# Huddle — web client environment (optional)
# Copy to .env in apps/web/ to enable optional features.

# GitHub OAuth App client id — enables the "Continue with GitHub" button
# in the Sign-in modal. The server must also be configured with the matching
# GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET (see apps/worker secrets).
# Leave unset to show a "belum dikonfigurasi" toast instead of redirecting.
VITE_GITHUB_CLIENT_ID=

# Google OAuth client id — enables the "Continue with Google" (Gmail login)
# button in the Sign-in modal. The server must also be configured with the
# matching GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (apps/worker secrets).
# Create at https://console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: <CLIENT_URL>/auth/google/callback
VITE_GOOGLE_CLIENT_ID=