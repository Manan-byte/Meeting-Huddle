# Huddle — server environment (production)
# Copy to .env in apps/server/ (or set in your PaaS dashboard).

# HTTP/Socket.IO port (Render/Railway inject their own; default 3001)
PORT=3001

# Allowed CORS origin — must be the deployed web URL (e.g. https://huddle.onrender.com)
CORS_ORIGIN=http://localhost:3001

# Base URL for invite-link generation — same as CORS_ORIGIN in production
CLIENT_URL=http://localhost:5173

# Where db.json lives (accounts, history, schedule). Use a persistent volume in prod.
DATA_DIR=./data

# ── GitHub OAuth login ("Continue with GitHub") ─────────────────────
# Create a GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Homepage URL: <CLIENT_URL>  |  Callback URL: <CLIENT_URL>/auth/github/callback
# Leave empty to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── LiveKit (SFU video engine) ──────────────────────────────────────
# The video layer uses LiveKit (Selective Forwarding Unit), replacing the old
# P2P WebRTC mesh, so meetings scale to many participants.
# Create a project at https://livekit.io/cloud → get URL + API key + secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cloudflare D1 (serverless database) ─────────────────────────────
# Replaces the old db.json file. Get these from your Cloudflare dashboard:
#   CF_ACCOUNT_ID  → https://dash.cloudflare.com → your account ID
#   D1_DATABASE_ID → Workers & Pages → D1 → your database → database ID
#    → My Profile → API Tokens → create token with
#                    "D1 - Edit" permission (account-scoped)
# Leave empty to run with in-memory fallback (auth/data features degrade).
CF_ACCOUNT_ID=cfut_aoFtGHJWwLzzkDye5g3rA5XcjKdbIUd11W0GYE0S81d5296a
D1_DATABASE_ID=f0595706-664f-4409-9649-629b94e974cc
CF_API_TOKEN=cfut_aoFtGHJWwLzzkDye5g3rA5XcjKdbIUd11W0GYE0S81d5296a
